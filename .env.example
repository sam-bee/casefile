# Create a private .env with ./scripts/init-env.sh. Do not put a real password here.
CASEFILE_DB_PASSWORD=replace-with-a-random-hex-password
CASEFILE_PORT=8090
# Pick a local, unsynced directory with enough free space. The init script
# chooses the XDG state directory (or ~/.local/state) by default.
CASEFILE_DATA_DIR=/path/to/local/nightwatch-casefile-data
